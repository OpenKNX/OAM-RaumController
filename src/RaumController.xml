<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_20/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns="http://knx.org/xml/project/20" xmlns:op="http://github.com/OpenKNX/OpenKNXproducer">


  <op:config name="%WIRE_BusMasterCount%" value="1" />

  <op:config href="RaumController.conf.xml" />
  
  <op:nowarn id="1" regex="ROOM_ApplicationVersion" />
  
  <op:ETS OpenKnxId="0xA0"
    ApplicationNumber="0x11"
    ApplicationVersion="%ROOM_ApplicationVersion_Dev%"
    ReplacesVersionsDownTo="0.3"
    ApplicationRevision="0"
    ProductName="RaumController"
    BuildSuffix="-Dev"
    BuildSuffixText=" (Dev)"
    OrderNumber="OpenKnxRaumController"
    SerialNumber="0xA011"
    MediumTypes="MT-0 MT-5"
  />

  <op:define prefix="BUTTONLINK"
             share="RaumController-VirtualButton.link.xml"
             noConfigTransfer="true"
             isSubmoduleOf="BTN"
             ModuleType="50" >
  </op:define>

  <op:define prefix="BASE"
             share="../lib/OGM-Common/src/Common.share.xml"
             ModuleType="10" >
    <op:verify File="../lib/OGM-Common/library.json" ModuleVersion="%BASE_VerifyVersion%" />
  </op:define>

  <op:define prefix="NET" 
            share="../lib/OFM-Network/src/Network.share.xml"
            ModuleType="11">
    <op:verify File="../lib/OFM-Network/library.json" ModuleVersion="%NET_VerifyVersion%" /> 
  </op:define>

  <!-- FTC access-control config (FTM_Security stage + FTM_Password + auto-logout). Pulled because this
       product builds with the FTC device profile; the share carries 0 ComObjects, so the KO layout is
       unchanged. ModuleType 13 was free here. Dynamic + Baggages arrive via the generic op:includetemplate
       Dynamic is injected into the BASE 'Erweitert' block in the <generate> section below. -->
  <op:define prefix="FTM"
             share="../lib/OFM-FileTransferModule/src/FileTransfer.share.xml"
             noConfigTransfer="true"
             ModuleType="13">
    <op:verify File="../lib/OFM-FileTransferModule/library.json" ModuleVersion="%FTM_VerifyVersion%" />
  </op:define>
 
  <op:define prefix="UCT"
    share="../../OFM-ConfigTransfer/src/ConfigTransfer.share.xml"
    noConfigTransfer="true"
    ModuleType="21">
    <op:verify File="../../OFM-ConfigTransfer/library.json" ModuleVersion="%UCT_VerifyVersion%" />
  </op:define>

  <op:define prefix="SENS" 
             share="../lib/OFM-SensorModule/src/Sensormodul.share.xml"
             KoSingleOffset="43"
             ModuleType="40" >
    <op:verify File="../lib/OFM-SensorModule/library.json" ModuleVersion="%SENS_VerifyVersion%" />
  </op:define>

  <!-- 
  1 KOs / Channel
  => 30*1=30 KOs
  => [90,120[
  -->
  <op:define prefix="WIRE" 
             share="../lib/OFM-OneWireModule/src/WireGateway.share.xml"
             template="../lib/OFM-OneWireModule/src/WireGateway.templ.xml"
             NumChannels="3" 
             KoSingleOffset="30" 
             KoOffset="90"  
             ModuleType="20" >
    <op:verify File="../lib/OFM-OneWireModule/library.json" ModuleVersion="%WIRE_VerifyVersion%" />
  </op:define>

  <!-- 
  20 KOs / Channel
  => 20*16=320 KOs
  => [120,440[
  -->
  <op:define prefix="PM"
    share="../lib/OFM-PresenceModule/src/PMmodul.share.xml"
    template="../lib/OFM-PresenceModule/src/PMmodul.templ.xml"
    NumChannels="3"
    KoOffset="120"
    ModuleType="30">
    <op:verify File="../lib/OFM-PresenceModule/library.json" ModuleVersion="%PM_VerifyVersion%" />
  </op:define>

  <!-- 
  49 KOs / Channel + 20 constant KOs
  => 3*49+20=166 KOs
  => [440,606[
  -->
  <op:define prefix="SHC" 
    ModuleType="23" 
    share="../lib/OFM-ShutterControllerModule/src/ShutterControllerModule.share.xml" 
    template="../lib/OFM-ShutterControllerModule/src/ShutterControllerModule.templ.xml" 
    NumChannels="3" 
    KoSingleOffset="440" 
    KoOffset="460">
    <op:verify File="../lib/OFM-ShutterControllerModule/library.json" ModuleVersion="%SHC_VerifyVersion%" />
  </op:define>

  <!-- 
  12 KOs / Channel
  => 10*12=120 KOs
  => [610,730[
  -->
  <op:define prefix="BTN"
    share="../lib/OFM-VirtualButton/src/VirtualButton.share.xml"
    template="../lib/OFM-VirtualButton/src/VirtualButton.templ.xml"
    NumChannels="10"
    KoOffset="610"
    ModuleType="50">
    <op:verify File="../lib/OFM-VirtualButton/library.json" ModuleVersion="%BTN_VerifyVersion%" />
  </op:define>

  <!-- 
  1 KO / Channel
  => 10*1=10 KOs (max 10 reserved)
  => [1320,1329[
  -->
  <op:define prefix="BI"
    share="../lib/OFM-BinaryInput/src/BinaryInputChannel.share.xml"
    template="../lib/OFM-BinaryInput/src/BinaryInputChannel.templ.xml"
    NumChannels="10"
    KoOffset="1320"
    ModuleType="24">
    <op:verify File="../lib/OFM-BinaryInput/library.json" ModuleVersion="%BI_VerifyVersion%" />
  </op:define>

  <!-- 
  1 KO / Channel
  => 4*1=4 KOs (max 10 reserved)
  => [1330,1334[
  -->
  <op:define prefix="ADC"
    share="../lib/OFM-ADCInput/src/ADCInputChannel.share.xml"
    template="../lib/OFM-ADCInput/src/ADCInputChannel.templ.xml"
    NumChannels="4"
    KoOffset="1330"
    ModuleType="25">
    <op:verify File="../lib/OFM-ADCInput/library.json" ModuleVersion="%ADC_VerifyVersion%" />
  </op:define>

  <!-- 
  6 KOs 
  => 6 KOs
  => [1334,1340[
  -->
  <op:define prefix="BUZZ"
    share="../lib/OFM-Feedback/src/Feedback.share.xml"
    KoSingleOffset="1334"
    ModuleType="27">
    <op:verify File="../lib/OFM-Feedback/library.json" ModuleVersion="%BUZZ_VerifyVersion%" />
  </op:define>

  <!-- 
  5 KOs / Channel 
  => 4*5=20 KOs
  => [1340,1360[
  -->
  <op:define prefix="SLED"
    share="../lib/OFM-StatusLED/src/StatusLED.share.xml"
    template="../lib/OFM-StatusLED/src/StatusLED.templ.xml"
    NumChannels="4"
    KoOffset="1340"
    ModuleType="28">
    <op:verify File="../lib/OFM-StatusLED/library.json" ModuleVersion="%SLED_VerifyVersion%" />
  </op:define>


  <!-- 
  4 KOs / Channel
  => 10*4=40 KOs
  => [730,770[
  -->
  <op:define prefix="MTR"
    share="../lib/OFM-Meter/src/MeterModule.share.xml"
    template="../lib/OFM-Meter/src/MeterModule.templ.xml"
    NumChannels="5" 
    KoOffset="730"
    ModuleType="22">
    <op:verify File="../lib/OFM-Meter/library.json" ModuleVersion="%MTR_VerifyVersion%" /> 
  </op:define>

  <!-- 
  30 KOs / Channel
  => 5*30=150 KOs
  => [770,920[
  -->
  <op:define prefix="DFA"
             share="../lib/OFM-DFA/src/DfaModule.share.xml"
             template="../lib/OFM-DFA/src/DfaModule.templ.xml"
             NumChannels="5"
             KoOffset="770"
             ModuleType="9" >
    <op:verify File="../lib/OFM-DFA/library.json" ModuleVersion="%DFA_VerifyVersion%" />
  </op:define>

  <!-- 
  3 KOs / Channel
  => 99*3=297 KOs
  => [920,1217[
  -->
  <op:define prefix="LOG"
    share="../lib/OFM-LogicModule/src/Logikmodul.share.xml"
    template="../lib/OFM-LogicModule/src/Logikmodul.templ.xml"
    NumChannels="20"
    KoOffset="920"
    ModuleType="10">
    <op:verify File="../lib/OFM-LogicModule/library.json" ModuleVersion="%LOG_VerifyVersion%" />
  </op:define>

  <!-- 
  10 KOs / Channel
  => 10*10=100 KOs
  => [1220,1320[
  -->
  <op:define prefix="FCB"
    share="../lib/OFM-FunctionBlocks/src/FunctionBlocks.share.xml"
    template="../lib/OFM-FunctionBlocks/src/FunctionBlocks.templ.xml"
    NumChannels="5"
    KoOffset="1220"
    ModuleType="26">
    <op:verify File="../lib/OFM-FunctionBlocks/library.json" ModuleVersion="%FCB_VerifyVersion%" />
  </op:define>

  <generate>
          <Dynamic>
            <!-- BASE "OpenKNX" channel rebuilt in place (position preserved) so composed modules can be
                 injected below Common's own "Erweitert" content. Convention: a module whose share ships a
                 ParameterBlock Name="ExtendedInject" is folded in via the op:include below, so the section
                 appears iff that module is op:define'd (auto-conditional, pure XML). Mirrors OAM-NeoPixel
                 and OAM-IP-Interface. OpenKNXproducerGeneratedModules is kept: this product registers
                 ConfigTransfer (UCT), so the producer post-process completes that block.
                 Rebuilding the channel replaces the producer's default per-define loop, so every module's
                 Dynamic is listed explicitly below, in op:define order. A new op:define needs a line here. -->
            <Channel Id="%AID%_CH-BASE" Number="BASE" Name="BASE_Main" Text="OpenKNX" Icon="openknx" HelpContext="BASE-OpenKNX">
              <op:include href="../lib/OGM-Common/src/Common.share.xml" xpath="//ApplicationProgram/Dynamic/Channel/ParameterBlock[@Name='Basic']" prefix="BASE" />
              <ParameterBlock Id="%AID%_PB-nnn" Name="Extended" Text="Erweitert" Icon="format-list-text" HelpContext="BASE-OpenKNX">
                <op:include href="../lib/OGM-Common/src/Common.share.xml" xpath="//ApplicationProgram/Dynamic/Channel/ParameterBlock[@Name='Extended']/*" IsInner="true" prefix="BASE" />
                <op:include href="../lib/OFM-FileTransferModule/src/FileTransfer.share.xml" xpath="//Dynamic/Channel/ParameterBlock/*" IsInner="true" prefix="FTM" />
              </ParameterBlock>
              <op:include href="../lib/OGM-Common/src/Common.share.xml" xpath="//ApplicationProgram/Dynamic/Channel/*[not(self::ParameterBlock[@Name='Basic']) and not(self::ParameterBlock[@Name='Extended'])]" prefix="BASE" />
            </Channel>
            <op:include href="../lib/OFM-Network/src/Network.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="NET" />
            <op:include href="../../OFM-ConfigTransfer/src/ConfigTransfer.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="UCT" />
            <op:include href="../lib/OFM-SensorModule/src/Sensormodul.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="SENS" />
            <op:include href="../lib/OFM-OneWireModule/src/WireGateway.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="WIRE" />
            <op:include href="../lib/OFM-PresenceModule/src/PMmodul.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="PM" />
            <op:include href="../lib/OFM-ShutterControllerModule/src/ShutterControllerModule.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="SHC" />
            <op:include href="../lib/OFM-VirtualButton/src/VirtualButton.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="BTN" />
            <op:include href="../lib/OFM-BinaryInput/src/BinaryInputChannel.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="BI" />
            <op:include href="../lib/OFM-ADCInput/src/ADCInputChannel.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="ADC" />
            <op:include href="../lib/OFM-Feedback/src/Feedback.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="BUZZ" />
            <op:include href="../lib/OFM-StatusLED/src/StatusLED.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="SLED" />
            <op:include href="../lib/OFM-Meter/src/MeterModule.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="MTR" />
            <op:include href="../lib/OFM-DFA/src/DfaModule.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="DFA" />
            <op:include href="../lib/OFM-LogicModule/src/Logikmodul.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="LOG" />
            <op:include href="../lib/OFM-FunctionBlocks/src/FunctionBlocks.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="FCB" />
          </Dynamic>
</generate>
</KNX>